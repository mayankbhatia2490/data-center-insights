# ============================================================
# Data Center Pulse — Environment Variables Template
# ============================================================

# --- Supabase ---
# Your Supabase project URL (e.g. https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Supabase anon/publishable key (safe for frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase project ID (used to construct edge function URLs)
VITE_SUPABASE_PROJECT_ID=

# --- Supabase Edge Function Secrets ---
# (Set these as Supabase secrets via: supabase secrets set KEY=value)
# SUPABASE_URL= (auto-available in edge functions)
# SUPABASE_SERVICE_ROLE_KEY= (full admin access — NEVER expose to frontend)

# --- AI Provider: Google Gemini (replaces Lovable AI Gateway) ---
# Get a FREE key at: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day — sufficient for all cron jobs
# Used by: ALL AI-powered edge functions (fetch-news, generate-digest, news-chat, etc.)
GEMINI_API_KEY=

# --- PRIMARY News Source: NewsData.io ---
# MENA-first news aggregation with direct country filtering
# Countries covered: UAE, Saudi Arabia, Qatar, Bahrain, Kuwait, Oman, Egypt, Jordan, Lebanon, Iraq
# Get key at: https://newsdata.io/register
# Free tier: 200 requests/day | Paid: ~$149/month for unlimited
NEWSDATA_API_KEY=

# --- Financial Data ---
# Alpha Vantage — used by fetch-stocks for real-time stock quotes
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- Email Delivery ---
# Resend — used by send-newsletter to email subscribers
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=

# --- Optional ---
# Firecrawl — optional web scraping for supplementary content
# Not required with NewsData.io as primary source
# FIRECRAWL_API_KEY=

# Site URL for newsletter unsubscribe links
# SITE_URL=https://your-domain.com

# --- REMOVED (no longer needed) ---
# LOVABLE_API_KEY — Replaced by GEMINI_API_KEY
# NEWS_API_KEY (newsapi.org) — Replaced by NEWSDATA_API_KEY (better MENA coverage)
