# ============================================================
# Data Center Pulse — Environment Variables Template
# ============================================================

# --- Supabase ---
# Your Supabase project URL (e.g. https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Supabase anon/publishable key (safe for frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase project ID (used to construct edge function URLs)
VITE_SUPABASE_PROJECT_ID=

# --- Supabase Edge Function Secrets ---
# (Set these as Supabase secrets, NOT in .env)

# Supabase URL (auto-available in edge functions as SUPABASE_URL)
# SUPABASE_URL=

# Supabase service role key (full admin access — NEVER expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI Gateway ---
# Lovable AI Gateway key (or replace with direct Gemini/OpenAI key after migration)
# Used by: fetch-news, generate-digest, news-chat, fetch-stocks, fetch-events,
#          fetch-stats, compute-trending, generate-weekly-index, market-signals,
#          strategic-insights, regional-outlook, word-cloud, extract-capacity,
#          extract-people, backfill-insights
# Current gateway: https://ai.gateway.lovable.dev/v1/chat/completions
# Migration: Replace with https://generativelanguage.googleapis.com/v1beta/ (Gemini)
#            or https://api.openai.com/v1/ (OpenAI)
LOVABLE_API_KEY=

# --- External APIs ---

# NewsAPI.org — used by fetch-news for additional article sourcing
# Get key at: https://newsapi.org/register
NEWS_API_KEY=

# Firecrawl — used by fetch-news (web search) and fetch-events (event discovery)
# Get key at: https://firecrawl.dev
FIRECRAWL_API_KEY=

# Alpha Vantage — used by fetch-stocks for real-time stock quotes
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Resend — used by send-newsletter for email delivery
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=

# --- Optional ---

# Site URL for newsletter unsubscribe links (defaults to https://datacenterpulse.com)
# SITE_URL=https://your-domain.com
