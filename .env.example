# ============================================================
# Data Center Pulse — Environment Variables Template
# ============================================================

# --- Supabase ---
# Your Supabase project URL (e.g. https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Supabase anon/publishable key (safe for frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase project ID (used to construct edge function URLs)
VITE_SUPABASE_PROJECT_ID=

# --- Supabase Edge Function Secrets ---
# (Set these as Supabase secrets via: supabase secrets set KEY=value)
# SUPABASE_URL= (auto-available in edge functions)
# SUPABASE_SERVICE_ROLE_KEY= (full admin access — NEVER expose to frontend)

# --- AI Provider: Google Gemini (replaces Lovable AI Gateway) ---
# Get a FREE key at: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day — sufficient for all cron jobs
# Used by: ALL AI-powered edge functions (summarize, sentiment, insight, people, quality gate)
GEMINI_API_KEY=

# --- News Sources ---

# 1. NewsData.io — PRIMARY source for MENA region (direct country filter)
#    Covers: UAE (ae), Saudi Arabia (sa), Qatar (qa), Bahrain (bh),
#            Kuwait (kw), Oman (om), Egypt (eg), Jordan (jo), Lebanon (lb), Iraq (iq)
#    Get key at: https://newsdata.io/register
#    Free tier: 200 req/day | Paid: ~$149/month unlimited
NEWSDATA_API_KEY=

# 2. NewsAPI.org — SECONDARY source for global breaking news
#    Covers: Global English news + MENA-specific keyword queries added
#    Get key at: https://newsapi.org/register
#    Free tier: 100 req/day (dev) | Paid: $449/month (production)
#    Note: If not set, this source is gracefully skipped.
NEWS_API_KEY=

# --- Financial Data ---
# Alpha Vantage — used by fetch-stocks for real-time stock quotes
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- Email Delivery ---
# Resend — used by send-newsletter to deliver digest emails to subscribers
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=

# --- Optional ---
# Firecrawl — supplementary web scraping (not required with NewsData.io + NewsAPI)
# FIRECRAWL_API_KEY=

# Site URL for newsletter unsubscribe links
# SITE_URL=https://your-domain.com

# --- REMOVED ---
# LOVABLE_API_KEY — Replaced by GEMINI_API_KEY above.
