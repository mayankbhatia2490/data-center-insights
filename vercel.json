{
  "rewrites": [
    { "source": "/news", "destination": "/spa.html" },
    { "source": "/news/:slug", "destination": "/spa.html" },
    { "source": "/data", "destination": "/spa.html" },
    { "source": "/data/facilities/:country/:slug", "destination": "/spa.html" },
    { "source": "/unsubscribe", "destination": "/spa.html" },
    { "source": "/confirm", "destination": "/spa.html" },
    { "source": "/archive", "destination": "/spa.html" },
    { "source": "/leaders", "destination": "/spa.html" },
    { "source": "/leaders/:id", "destination": "/spa.html" },
    { "source": "/stats", "destination": "/spa.html" },
    { "source": "/intelligence", "destination": "/spa.html" },
    { "source": "/insights", "destination": "/spa.html" },
    { "source": "/login", "destination": "/spa.html" },
    { "source": "/pricing", "destination": "/spa.html" },
    { "source": "/account", "destination": "/spa.html" },
    { "source": "/admin/claims", "destination": "/spa.html" },
    { "source": "/admin/people-verification", "destination": "/spa.html" },
    { "source": "/about", "destination": "/spa.html" },
    { "source": "/about/methodology", "destination": "/spa.html" },
    { "source": "/privacy", "destination": "/spa.html" },
    { "source": "/terms", "destination": "/spa.html" },
    { "source": "/contact", "destination": "/spa.html" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "data-center-insights-(git-.+|[a-z0-9]{9}-.+)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
